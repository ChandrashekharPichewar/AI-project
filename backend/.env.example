# Server Port
PORT=5000
NODE_ENV=development

# PostgreSQL Connection String with pgvector
# Example Neon/Supabase: postgresql://username:password@ep-cool-sample.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/knowledge_inbox"

# OpenAI API Key
OPENAI_API_KEY="sk-proj-your-openai-api-key"

# Models
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_CHAT_MODEL="gpt-4o-mini"

# CORS configuration (allow frontend origin, or * for dev)
CORS_ORIGIN="http://localhost:5173,https://your-frontend.netlify.app"

# Structured Logger Level (debug, info, warn, error)
LOG_LEVEL="info"
